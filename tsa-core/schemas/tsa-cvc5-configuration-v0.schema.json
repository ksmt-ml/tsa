{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ksmt.io/schemas/tsa-cvc5-configuration-v0.schema.json",
  "title": "TSA cvc5 configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "parameterSpaceId", "backendRole", "options"],
  "properties": {
    "schemaVersion": { "const": "tsa-cvc5-configuration-v0" },
    "parameterSpaceId": { "type": "string", "minLength": 1 },
    "backendRole": { "enum": ["regular-bv", "integer-blasted"] },
    "options": {
      "description": "cvc5 options to set on the named backend role. Evaluator- and KSMT-controlled names are refused.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "not": {
          "enum": [
            "logic",
            "tlimit-per",
            "produce-models",
            "produce-unsat-cores",
            "incremental",
            "arrays-exp",
            "fp-exp",
            "ksmt.optimize.theories",
            "ksmt.quantifiers-allowed"
          ]
        }
      },
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  }
}
